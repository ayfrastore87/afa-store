generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  phone                 String?               @unique
  passwordHash          String?
  image                 String?
  role                  String                @default("customer")
  isActive              Boolean               @default(true)
  addresses             Address[]
  wishlists             Wishlist[]
  cartItems             CartItem[]
  orders                Order[]
  userVouchers          UserVoucher[]
  checkoutHistories     CheckoutHistory[]
  checkoutIdempotencies CheckoutIdempotency[]
  passwordResetTokens   PasswordResetToken[]
  partner               Partner?
  partnerVisits         PartnerVisit[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("users")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  province      String
  city          String
  district      String
  village       String
  postalCode    String
  detail        String
  note          String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id       String    @id
  name     String
  slug     String
  products Product[]

  @@map("categories")
}

model Product {
  id                    String                 @id
  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id])
  name                  String
  slug                  String
  flavor                String?
  size                  String?
  price                 Int
  stock                 Int
  image                 String?
  badge                 String?
  rating                Float
  isActive              Boolean
  orderItems            OrderItem[]
  wishlists             Wishlist[]
  cartItems             CartItem[]
  partnerProductPrices  PartnerProductPrice[]
  partnerStocks         PartnerStock[]
  partnerStockMovements PartnerStockMovement[]
  partnerSaleItems      PartnerSaleItem[]
  createdAt             DateTime

  @@map("products")
}

model Wishlist {
  id         String   @id @default(cuid())
  userId     String
  productId  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productRef String
  name       String
  price      Int
  image      String?
  createdAt  DateTime @default(now())

  @@unique([userId, productRef])
  @@map("wishlists")
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  productId  String?
  productRef String
  name       String
  price      Int
  image      String?
  quantity   Int      @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cart_items")
}

model Order {
  id                  String               @id @default(cuid())
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  invoice             String               @unique
  customer            String
  phone               String
  address             String
  note                String?
  subtotal            Int
  shipping            Int                  @default(0)
  voucher             String?
  discount            Int                  @default(0)
  total               Int
  status              String               @default("pending")
  paymentMethod       String               @default("QRIS") @map("payment_method")
  paymentStatus       String               @default("WAITING_PAYMENT") @map("payment_status")
  paymentProof        String?              @map("payment_proof")
  source              String               @default("ONLINE")
  cashReceived        Int?
  change              Int?
  courier             String?
  trackingNumber      String?
  paidAt              DateTime?
  processedAt         DateTime?
  packedAt            DateTime?
  shippedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  items               OrderItem[]
  checkoutHistories   CheckoutHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  payment             Payment?
  checkoutIdempotency CheckoutIdempotency?

  @@map("orders")
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         String
  amount         Int
  status         String    @default("PENDING")
  transactionId  String?
  transactionRef String?   @unique
  paymentType    String?
  qrisUrl        String?
  rawResponse    Json?
  expiredAt      DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("payments")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Int
  subtotal  Int

  @@map("order_items")
}

model Voucher {
  id           String        @id @default(cuid())
  code         String        @unique
  title        String
  description  String?
  discountType String        @default("percent")
  value        Int
  minSpend     Int           @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean       @default(true)
  userVouchers UserVoucher[]
  createdAt    DateTime      @default(now())

  @@map("vouchers")
}

model UserVoucher {
  id        String    @id @default(cuid())
  userId    String
  voucherId String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, voucherId])
  @@map("user_vouchers")
}

model CheckoutHistory {
  id        String   @id @default(cuid())
  userId    String?
  orderId   String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel   String   @default("whatsapp")
  items     Json
  subtotal  Int
  shipping  Int
  discount  Int
  total     Int
  city      String?
  voucher   String?
  message   String
  createdAt DateTime @default(now())

  @@map("checkout_histories")
}

model CheckoutIdempotency {
  id              String    @id @default(cuid())
  key             String    @unique
  userId          String
  orderId         String?   @unique
  requestHash     String
  status          String
  responsePayload Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  city       String
  whatsapp   String?
  message    String
  rating     Int      @default(5)
  avatar     String?
  isActive   Boolean  @default(false)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String?
  ctaLabel  String?
  ctaUrl    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("banners")
}

model Promotion {
  id       String   @id @default(cuid())
  title    String
  type     String
  value    Int
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  @@map("promotions")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("settings")
}

model Partner {
  id             String                 @id @default(cuid())
  userId         String                 @unique
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  partnerCode    String                 @unique
  partnerType    String                 @default("INDIVIDUAL")
  status         String                 @default("PENDING")
  displayName    String
  businessName   String?
  phone          String?
  address        String?
  village        String?
  district       String?
  city           String?
  postalCode     String?
  prices         PartnerProductPrice[]
  stocks         PartnerStock[]
  stockMovements PartnerStockMovement[]
  sales          PartnerSale[]
  locations      PartnerLocation[]
  visits         PartnerVisit[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status])
  @@map("partners")
}

model PartnerProductPrice {
  id            String    @id @default(cuid())
  partnerId     String
  productId     String
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([partnerId, productId, effectiveFrom])
  @@index([productId])
  @@map("partner_product_prices")
}

model PartnerStock {
  id        String   @id @default(cuid())
  partnerId String
  productId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, productId])
  @@index([productId])
  @@map("partner_stocks")
}

model PartnerStockMovement {
  id            String   @id @default(cuid())
  partnerId     String
  productId     String?
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  type          String
  quantity      Int
  unitPrice     Int?
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([partnerId, productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("partner_stock_movements")
}

model PartnerSale {
  id             String            @id @default(cuid())
  partnerId      String
  saleNumber     String            @unique
  idempotencyKey String?           @unique
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  soldAt         DateTime          @default(now())
  subtotal       Int
  total          Int
  grossProfit    Int
  status         String            @default("COMPLETED")
  note           String?
  items          PartnerSaleItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([partnerId, soldAt])
  @@map("partner_sales")
}

model PartnerSaleItem {
  id                   String      @id @default(cuid())
  saleId               String
  productId            String?
  sale                 PartnerSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product              Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                 String
  quantity             Int
  costPriceSnapshot    Int
  sellingPriceSnapshot Int
  subtotalCost         Int
  subtotalRevenue      Int

  @@index([saleId])
  @@map("partner_sale_items")
}

model PartnerLocation {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  source     String   @default("MANUAL")
  consent    Boolean  @default(false)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([partnerId, recordedAt])
  @@map("partner_locations")
}

model PartnerVisit {
  id            String    @id @default(cuid())
  partnerId     String
  visitedBy     String?
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  visitedByUser User?     @relation(fields: [visitedBy], references: [id], onDelete: SetNull)
  checkInAt     DateTime?
  checkInLat    Float?
  checkInLng    Float?
  checkOutAt    DateTime?
  checkOutLat   Float?
  checkOutLng   Float?
  note          String?
  photoUrl      String?
  status        String    @default("IN_PROGRESS")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([partnerId, createdAt])
  @@map("partner_visits")
}
